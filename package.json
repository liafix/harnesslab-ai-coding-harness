{
  "name": "harnesslab-candidate-demo",
  "version": "0.6.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "validate:domain": "tsc -p tsconfig.domain.json",
    "test": "vitest run",
    "release:smoke": "node scripts/release-smoke.mjs",
    "validate": "npm run release:smoke && npm run validate:domain && npm run lint && npm run typecheck && npm run test && npm run build",
    "validate:release": "npm run release:smoke && npm run validate:domain"
  },
  "dependencies": {
    "next": "15.5.24",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "eslint": "9.28.0",
    "eslint-config-next": "15.5.24",
    "typescript": "5.8.3",
    "vitest": "3.2.4",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.17"
  }
}
